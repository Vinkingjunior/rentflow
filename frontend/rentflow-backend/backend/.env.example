# Copy to .env and fill in. Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/rentflow
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins that serve your frontend (NOT the API's own port)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
